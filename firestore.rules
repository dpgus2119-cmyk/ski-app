rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validMemberProfile() {
      return request.resource.data.keys().hasAll([
          'email', 'displayName', 'phone', 'points', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'phone', 'points', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.phone is string
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get, list: if owns(uid);
      allow create: if owns(uid)
        && validMemberProfile()
        && request.resource.data.points == 0;
      allow update: if owns(uid)
        && validMemberProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /rentalRecords/{recordId} {
        allow get, list: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.keys().hasAll(['items', 'status', 'startedAt', 'createdAt'])
          && request.resource.data.keys().hasOnly(['items', 'status', 'startedAt', 'createdAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.status == 'rented'
          && request.resource.data.startedAt is timestamp
          && request.resource.data.createdAt is timestamp;
        allow update: if owns(uid)
          && resource.data.status == 'rented'
          && request.resource.data.status == 'returned'
          && request.resource.data.endedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt']);
        allow delete: if false;
      }

      match /usageRecords/{recordId} {
        allow get, list: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.keys().hasAll([
            'rentalIds', 'items', 'startedAt', 'endedAt', 'minutes', 'gearCost',
            'timeCost', 'totalAmount', 'pointsUsed', 'pointsAdded', 'paymentMethod', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'rentalIds', 'items', 'startedAt', 'endedAt', 'minutes', 'gearCost',
            'timeCost', 'totalAmount', 'pointsUsed', 'pointsAdded', 'paymentMethod', 'createdAt'
          ])
          && request.resource.data.items is list
          && request.resource.data.startedAt is timestamp
          && request.resource.data.endedAt is timestamp
          && request.resource.data.createdAt is timestamp
          && request.resource.data.minutes is int
          && request.resource.data.totalAmount is int
          && request.resource.data.pointsUsed is int
          && request.resource.data.pointsAdded is int;
        allow update, delete: if false;
      }
    }

    // Keep the existing default-deny rule for all other document paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
